# ==========================================
# GrowWise .gitignore
# ==========================================

# --- Node & Frontend ---
node_modules/
frontend/node_modules/
.astro/
frontend/.astro/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Python & Backend ---
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
backend/venv/
.venv/
backend/.venv/
env/
backend/env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
*.pem
*.key

# --- IDE & Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Local Databases & Temporary Dumps ---
*.sqlite
*.sqlite3
*.db
!data/*.json
